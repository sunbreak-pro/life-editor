{
  "mcpServers": {
    "life-editor": {
      "command": "node",
      "args": [
        "${LIFE_EDITOR_MCP_ENTRY:-/Users/newlife/dev/apps/life-editor/mcp-server/dist/index.js}"
      ],
      "env": {
        "LIFE_EDITOR_SUPABASE_URL": "${LIFE_EDITOR_SUPABASE_URL}",
        "LIFE_EDITOR_SUPABASE_ANON_KEY": "${LIFE_EDITOR_SUPABASE_ANON_KEY}",
        "LIFE_EDITOR_SUPABASE_EMAIL": "${LIFE_EDITOR_SUPABASE_EMAIL}",
        "LIFE_EDITOR_SUPABASE_PASSWORD": "${LIFE_EDITOR_SUPABASE_PASSWORD}"
      },
      "type": "stdio"
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=mcrfdnjplfmqwnwbcbol"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      },
      "type": "stdio"
    }
  }
}
